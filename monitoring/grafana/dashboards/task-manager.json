{
  "title": "Task Manager",
  "uid": "task-manager",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Tasks created",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "tasks_total"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Successful logins",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "users_login_success_total"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Tasks created (increase 5m)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(tasks_total[5m])"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Successful logins (increase 5m)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(users_login_success_total[5m])"
        }
      ]
    }
  ]
}
